# ============================================================
# ENIZZY TRADER — Environment Variables Example
# Copy this file to .env and fill in your values
# Never commit your .env file
# ============================================================

# --- AI Brain (Claude Opus 4.6 via OpenClaw) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENCLAW_API_KEY=your-openclaw-key
AI_MODEL=claude-opus-4-6

# --- Solana ---
SOLANA_PRIVATE_KEY=your-base58-private-key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_AUTO_TRADING=true

# --- BSC (BNB Smart Chain) ---
BSC_PRIVATE_KEY=your-bsc-hex-private-key
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_AUTO_TRADING=true

# --- Scanner APIs ---
BIRDEYE_API_KEY=your-birdeye-key
# DexScreener and Pump.fun are public — no key needed

# --- Trading Parameters ---
MAX_TRADE_SOL=0.1
MAX_TRADE_BNB=0.05
SLIPPAGE_BPS=300
MIN_LIQUIDITY_USD=5000

# --- Telegram Alerts ---
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- Dashboard ---
PORT=3002
