# ============================================================
# KIBBY TRADER — Environment Variables Example
# Copy this file to .env and fill in your values
# Never commit your .env file
# ============================================================

# --- AI Provider (choose one or both) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Which model to use: "openai" or "anthropic"
AI_MODEL=openai

# --- Solana ---
SOLANA_PRIVATE_KEY=your-base58-private-key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Scanner APIs ---
LIQUIDAF_API_KEY=your-liquidaf-key
# DexScreener and Pump.fun are public — no key needed

# --- Trading Parameters ---
MAX_TRADE_SOL=0.1
SLIPPAGE_BPS=300
MIN_LIQUIDITY_USD=5000

# --- Dashboard (optional) ---
PORT=3000
